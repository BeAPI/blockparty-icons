<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 name="BeAPI Blockparty Icons"
		 xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">

	<description>WordPress coding standards for Blockparty Icons plugin</description>

	<!-- Scan all files in directory -->
	<file>blockparty-icons.php</file>
	<file>./includes/</file>

	<exclude-pattern>./build/</exclude-pattern>
	<!--
		The performance harness is not plugin code and is excluded from releases by
		.distignore. It has to break WordPress conventions to do its job: the object
		cache drop-in must assign $GLOBALS['wp_object_cache'] and declare both a class
		and the wp_cache_* functions in one file.

		Scoped to tests/perf on purpose — the PHPUnit suite under tests/phpunit is
		held to the standard like the rest of the code.
	-->
	<exclude-pattern>./tests/perf/</exclude-pattern>
	<exclude-pattern>./node_modules/</exclude-pattern>
	<exclude-pattern>./src/</exclude-pattern>
	<exclude-pattern>./tools/</exclude-pattern>
	<exclude-pattern>./vendor/</exclude-pattern>
	<exclude-pattern>./.wp-env/</exclude-pattern>

    <rule ref="WordPress-Extra">
        <!-- Exclude as we use a custom autoloader. -->
        <exclude name="WordPress.Files.FileName"/>

        <!-- Exclude as it conflict with @var declaration. -->
        <exclude name="Squiz.PHP.CommentedOutCode.Found"/>

        <!-- Exclude as we use the short array syntax over the long one. -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax.Found"/>

        <!-- Allow to use short ternary operators since they are very usefull. -->
        <exclude name="WordPress.PHP.DisallowShortTernary.Found"/>
    </rule>

	<config name="minimum_supported_wp_version" value="6.2"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="blockparty-icons"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibility"/>
	<config name="testVersion" value="8.1-"/>

	<!-- Scan only PHP files -->
	<arg name="extensions" value="php"/>

	<!-- Show sniff name in report. -->
	<arg value="sp"/>

	<!-- Show progress. -->
	<arg value="p"/>

	<!-- Use colors. -->
	<arg name="colors"/>

	<!-- Set ini. -->
	<ini name="memory_limit" value="512M"/>
	<ini name="max_execution_time" value="-1"/>
</ruleset>
